<Window x:Class="UiTreeMonitor.App.AddMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控对象" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Margin="20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 监控目标（只读显示） -->
        <TextBlock Grid.Row="0" Text="监控目标：" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtMonitorProperty" Grid.Row="0" Grid.Column="1" IsReadOnly="True"
                 Background="#E8E8E8" Foreground="#333333" BorderBrush="#CCCCCC"
                 Margin="0,0,0,10" MinHeight="26" VerticalContentAlignment="Center"
                 ToolTip="从 Details 面板右键选择的属性路径（如 ValuePattern.Value）"/>

        <!-- 目标进程（只读显示） -->
        <TextBlock Grid.Row="1" Text="目标进程：" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtProcessName" Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                 Background="#E8E8E8" Foreground="#333333" BorderBrush="#CCCCCC"
                 Margin="0,0,0,10" MinHeight="26" VerticalContentAlignment="Center"/>

        <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4"/>

        <!-- 采集间隔 -->
        <TextBlock Grid.Row="3" Text="采集间隔：" VerticalAlignment="Center" Margin="0,8,0,6"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,6">
            <RadioButton x:Name="RbInterval500" Content="500ms" IsChecked="False" Margin="0,0,16,0" GroupName="Interval" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbInterval1000" Content="1秒" IsChecked="True" Margin="0,0,16,0" GroupName="Interval" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbInterval3000" Content="3秒" IsChecked="False" Margin="0,0,16,0" GroupName="Interval" VerticalAlignment="Center"/>
            <TextBlock Text="自定义:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtCustomInterval" Width="70" Height="26" VerticalContentAlignment="Center" ToolTip="自定义间隔（毫秒，最小100）"/>
        </StackPanel>

        <!-- 监控时长 -->
        <TextBlock Grid.Row="4" Text="监控时长：" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RbDuration0" Content="无限" IsChecked="True" Margin="0,0,16,0" GroupName="Duration" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbDuration60" Content="1分钟" IsChecked="False" Margin="0,0,16,0" GroupName="Duration" VerticalAlignment="Center"/>
            <RadioButton x:Name="RbDuration300" Content="5分钟" IsChecked="False" Margin="0,0,16,0" GroupName="Duration" VerticalAlignment="Center"/>
            <TextBlock Text="自定义:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="TxtCustomDuration" Width="70" Height="26" VerticalContentAlignment="Center" ToolTip="自定义时长（秒，0=无限）"/>
        </StackPanel>

        <!-- 提示文字 -->
        <TextBlock Grid.Row="5" Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                 Margin="0,4,0,0" Text="任务启动后将按设定间隔持续采样目标属性的当前值，并在任务列表中实时显示。"/>

        <!-- 按钮行 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOK" Content="确定添加并启动" Padding="24,8" Click="BtnOK_Click" 
                    IsDefault="True" MinWidth="140" FontSize="13"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="24,8" Margin="16,0,0,0" Click="BtnCancel_Click" 
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
