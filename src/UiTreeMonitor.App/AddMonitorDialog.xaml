<Window x:Class="UiTreeMonitor.App.AddMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控对象" Height="400" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">
    <StackPanel Margin="20,16">
        <!-- 监控目标 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="监控目标：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMonitorProperty" Grid.Column="1" IsReadOnly="True"
                     Background="#E8E8E8" Foreground="#000000" BorderBrush="#BBBBBB"
                     Height="28" VerticalContentAlignment="Center" FontSize="13"
                     ToolTip="从 Details 面板右键选择的属性路径"/>
        </Grid>

        <!-- 目标进程 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标进程：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtProcessName" Grid.Column="1" IsReadOnly="True"
                     Background="#E8E8E8" Foreground="#000000" BorderBrush="#BBBBBB"
                     Height="28" VerticalContentAlignment="Center" FontSize="13"/>
        </Grid>

        <Separator Margin="0,0,0,12"/>

        <!-- 采集间隔 -->
        <TextBlock Text="采集间隔：" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel Margin="12,0,0,8">
            <RadioButton x:Name="RbInterval500" Content="500ms" IsChecked="False" GroupName="Interval" Margin="0,0,18,0" FontSize="13"/>
            <RadioButton x:Name="RbInterval1000" Content="1秒" IsChecked="True" GroupName="Interval" Margin="0,0,18,0" FontSize="13"/>
            <RadioButton x:Name="RbInterval3000" Content="3秒" IsChecked="False" GroupName="Interval" Margin="0,0,18,0" FontSize="13"/>
            <TextBlock Text="自定义:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtCustomInterval" Width="80" Height="26" VerticalContentAlignment="Center" FontSize="12" ToolTip="毫秒，最小100"/>
        </WrapPanel>

        <!-- 监控时长 -->
        <TextBlock Text="监控时长：" FontWeight="Bold" Margin="0,0,0,6"/>
        <WrapPanel Margin="12,0,0,12">
            <RadioButton x:Name="RbDuration0" Content="无限" IsChecked="True" GroupName="Duration" Margin="0,0,18,0" FontSize="13"/>
            <RadioButton x:Name="RbDuration60" Content="1分钟" IsChecked="False" GroupName="Duration" Margin="0,0,18,0" FontSize="13"/>
            <RadioButton x:Name="RbDuration300" Content="5分钟" IsChecked="False" GroupName="Duration" Margin="0,0,18,0" FontSize="13"/>
            <TextBlock Text="自定义:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtCustomDuration" Width="80" Height="26" VerticalContentAlignment="Center" FontSize="12" ToolTip="秒，0=无限"/>
        </WrapPanel>

        <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                 Text="任务启动后将按设定间隔持续采样目标属性的当前值，并在任务列表中实时显示。"/>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,8">
            <Button x:Name="BtnOK" Content="确定添加并启动" Padding="28,8" Click="BtnOK_Click" 
                    IsDefault="True" MinWidth="150" FontSize="13" FontWeight="Bold"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="28,8" Margin="20,0,0,0" Click="BtnCancel_Click" 
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </StackPanel>
</Window>
