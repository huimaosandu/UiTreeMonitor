<Window x:Class="UiTreeMonitor.App.AddMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控对象" Height="620" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">
    <StackPanel Margin="20,16">

        <!-- 任务名称（可自由编辑） -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="任务名称：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTaskName" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     ToolTip="可自由编辑，默认：进程-属性"/>
        </Grid>

        <!-- 监控目标 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="监控目标：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMonitorProperty" Grid.Column="1" IsReadOnly="True"
                     Background="#E8E8E8" Foreground="#000000" BorderBrush="#BBBBBB"
                     Height="28" VerticalContentAlignment="Center" FontSize="13"
                     ToolTip="从 Details 面板右键选择的属性路径"/>
        </Grid>

        <!-- 目标进程 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="目标进程：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtProcessName" Grid.Column="1" IsReadOnly="True"
                     Background="#E8E8E8" Foreground="#000000" BorderBrush="#BBBBBB"
                     Height="28" VerticalContentAlignment="Center" FontSize="13"/>
        </Grid>

        <Separator Margin="0,0,0,12"/>

        <!-- 采集间隔：数字 + 单位 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="采集间隔：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtIntervalValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     Text="500" ToolTip="最小 100ms"/>
            <ComboBox x:Name="CmbIntervalUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                      SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="ms" Tag="1"/>
                <ComboBoxItem Content="s" Tag="1000"/>
                <ComboBoxItem Content="min" Tag="60000"/>
                <ComboBoxItem Content="h" Tag="3600000"/>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="（最小 100ms）" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#999999" FontSize="12"/>
        </Grid>

        <!-- 监控时长：数字 + 单位 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="监控时长：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDurationValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     Text="0" ToolTip="0 = 无限监控"/>
            <ComboBox x:Name="CmbDurationUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                      SelectedIndex="1" VerticalContentAlignment="Center">
                <ComboBoxItem Content="s" Tag="1"/>
                <ComboBoxItem Content="min" Tag="60"/>
                <ComboBoxItem Content="h" Tag="3600"/>
            </ComboBox>
            <TextBlock Grid.Column="3" Text="（0 = 无限）" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#999999" FontSize="12"/>
        </Grid>

        <Separator Margin="0,0,0,12"/>

        <!-- 值提取规则（@@标记对 / re:正则；多规则=值1..值N 多列） -->
        <TextBlock Text="值提取规则：" FontWeight="Bold" Margin="0,0,0,6"/>
        <StackPanel Margin="12,0,0,4">
            <ItemsControl x:Name="ExtractRules">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Text="{Binding Rule, UpdateSourceTrigger=PropertyChanged}"
                                     Width="240" Height="26" VerticalContentAlignment="Center" FontSize="12"/>
                            <Button Content="删除" Margin="6,0,0,0" Padding="10,3" FontSize="12"
                                    Click="BtnRemoveRule_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="BtnAddRule" Content="＋ 添加规则" HorizontalAlignment="Left" Padding="10,3"
                    FontSize="12" Click="BtnAddRule_Click"/>
        </StackPanel>
        <TextBlock x:Name="TxtExtractHint" Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="12,2,0,8"/>

        <Separator Margin="0,0,0,12"/>

        <!-- 数据保存策略 -->
        <TextBlock Text="数据保存：" FontWeight="Bold" Margin="0,0,0,6"/>
        <Grid Margin="12,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="每" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSavePoints" Grid.Column="1" Height="26" Margin="4,0" VerticalContentAlignment="Center"
                     Text="1" ToolTip="积攒多少个采样点批量写盘一次；1 = 每点即存"/>
            <TextBlock Grid.Column="2" Text="点保存，或每" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <TextBox x:Name="TxtSaveSeconds" Grid.Column="3" Height="26" Width="70" VerticalContentAlignment="Center"
                     Text="5" ToolTip="最长间隔多少秒写盘一次（先到条件先触发）；0 = 不按时间"/>
            <TextBlock Grid.Column="4" Text="秒保存" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </Grid>
        <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="12,0,0,8"
                   Text="采样先进内存缓冲，后台线程按上述条件批量写入 CSV（先到者先写），不占用采集线程；任务停止/程序退出时自动写完剩余数据。"/>

        <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                   Text="任务启动后将按设定间隔持续采样目标属性的当前值，并在任务列表中实时显示。"/>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,8">
            <Button x:Name="BtnOK" Content="确定添加并启动" Padding="28,8" Click="BtnOK_Click"
                    IsDefault="True" MinWidth="150" FontSize="13" FontWeight="Bold"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="28,8" Margin="20,0,0,0" Click="BtnCancel_Click"
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </StackPanel>
</Window>
