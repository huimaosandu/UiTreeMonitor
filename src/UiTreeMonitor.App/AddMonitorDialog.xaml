<Window x:Class="UiTreeMonitor.App.AddMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控对象" Height="280" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="监控目标：" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtMonitorProperty" Grid.Row="0" Grid.Column="1" IsReadOnly="True" 
                 Background="#F0F0F0" Margin="0,0,0,8" ToolTip="从 Details 面板右键选择"/>

        <TextBlock Grid.Row="1" Text="目标进程：" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtProcessName" Grid.Row="1" Grid.Column="1" IsReadOnly="True" 
                 Background="#F0F0F0" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Text="采集间隔（毫秒）：" VerticalAlignment="Center" Margin="0,8,0,4"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,4">
            <RadioButton x:Name="RbInterval500" Content="500ms" IsChecked="False" Margin="0,0,12,0" GroupName="Interval"/>
            <RadioButton x:Name="RbInterval1000" Content="1000ms" IsChecked="True" Margin="0,0,12,0" GroupName="Interval"/>
            <RadioButton x:Name="RbInterval3000" Content="3000ms" IsChecked="False" Margin="0,0,12,0" GroupName="Interval"/>
            <TextBox x:Name="TxtCustomInterval" Width="70" Text="" ToolTip="自定义间隔（毫秒）"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="监控时长（秒，0=无限）：" VerticalAlignment="Center" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="RbDuration0" Content="无限" IsChecked="True" Margin="0,0,12,0" GroupName="Duration"/>
            <RadioButton x:Name="RbDuration60" Content="60秒" IsChecked="False" Margin="0,0,12,0" GroupName="Duration"/>
            <RadioButton x:Name="RbDuration300" Content="5分钟" IsChecked="False" Margin="0,0,12,0" GroupName="Duration"/>
            <TextBox x:Name="TxtCustomDuration" Width="70" Text="" ToolTip="自定义时长（秒）"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                 Margin="0,8,0,0" Text="任务启动后将按设定间隔持续采样目标属性的当前值，并在任务列表中实时显示。"/>

        <!-- 按钮行 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOK" Content="确定添加并启动" Padding="20,8" Click="BtnOK_Click" 
                    IsDefault="True" MinWidth="140"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="20,8" Margin="12,0,0,0" Click="BtnCancel_Click" 
                    IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
