<Window x:Class="UiTreeMonitor.App.AddMonitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加监控对象" SizeToContent="Height" Width="580"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区：超高自动滚动，按钮永远可见；窗口可拉伸高度 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 任务名称（可自由编辑） -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="任务名称：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtTaskName" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             ToolTip="可自由编辑，默认：进程-属性"/>
                </Grid>

                <!-- 监控目标（下拉选择：Properties 属性 / Pattern.子属性 路径） -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="监控目标：" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbMonitorProperty" Grid.Column="1" Height="28"
                              DisplayMemberPath="Name" VerticalContentAlignment="Center" FontSize="13"
                              ToolTip="下拉选择当前元素的属性（Properties）或 Pattern 子属性（如 ValuePattern.Value）"/>
                </Grid>

                <!-- 当前值（示例） -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前值：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSampleValue" Grid.Column="1" IsReadOnly="True"
                             Background="#F4F9FF" Foreground="#1D5FA6" BorderBrush="#BBBBBB"
                             Height="28" VerticalContentAlignment="Center" FontSize="13"
                             ToolTip="监控属性的当前值（提取规则示例），只读"/>
                </Grid>

                <!-- 目标进程 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标进程：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtProcessName" Grid.Column="1" IsReadOnly="True"
                             Background="#E8E8E8" Foreground="#000000" BorderBrush="#BBBBBB"
                             Height="28" VerticalContentAlignment="Center" FontSize="13"/>
                </Grid>

                <Separator Margin="0,0,0,12"/>

                <!-- 采集间隔：数字 + 单位 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="采集间隔：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtIntervalValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="500" ToolTip="最小 100ms"/>
                    <ComboBox x:Name="CmbIntervalUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                              SelectedIndex="0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="ms" Tag="1"/>
                        <ComboBoxItem Content="s" Tag="1000"/>
                        <ComboBoxItem Content="min" Tag="60000"/>
                        <ComboBoxItem Content="h" Tag="3600000"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="（最小 100ms）" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#999999" FontSize="12"/>
                </Grid>

                <!-- 监控时长：数字 + 单位 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="监控时长：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtDurationValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                             Text="0" ToolTip="0 = 无限监控"/>
                    <ComboBox x:Name="CmbDurationUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                              SelectedIndex="1" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="s" Tag="1"/>
                        <ComboBoxItem Content="min" Tag="60"/>
                        <ComboBoxItem Content="h" Tag="3600"/>
                    </ComboBox>
                    <TextBlock Grid.Column="3" Text="（0 = 无限）" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#999999" FontSize="12"/>
                </Grid>

                <Separator Margin="0,0,0,12"/>

                <!-- 值提取规则：示例值 + 插入标记圈选 + 实时预览；多规则=值1..值N 多列 -->
                <TextBlock Text="值提取规则：" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel Margin="12,0,0,4">
                    <ItemsControl x:Name="ExtractRules">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
                                        Margin="0,0,0,6" Padding="8,6">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Sample, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     Width="320" Height="26" VerticalContentAlignment="Center" FontSize="12"
                                                     ToolTip="复制自当前值：用「插入标记」在要提取的部分前后各插一次标记；或改为 re:正则"/>
                                            <Button Content="插入标记" Margin="6,0,0,0" Padding="8,3" FontSize="12"
                                                    Click="BtnInsertMarker_Click"
                                                    ToolTip="在光标处插入截取标记；选中一段文字则在其两端包裹标记"/>
                                            <Button Content="删除" Margin="6,0,0,0" Padding="8,3" FontSize="12"
                                                    Click="BtnRemoveRule_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Preview}" Foreground="#1D7A3D" FontSize="12"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="BtnAddRule" Content="＋ 添加规则" HorizontalAlignment="Left" Padding="10,3"
                            FontSize="12" Click="BtnAddRule_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtExtractHint" Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="12,4,0,8"/>

                <Separator Margin="0,0,0,12"/>

                <!-- 数据保存策略：候选 按点保存 / 按时间保存（单位可选） -->
                <TextBlock Text="数据保存：" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel Margin="12,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="RbSaveByPoints" Content="按点保存：每" GroupName="SaveMode"
                                     IsChecked="True" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSavePoints" Width="60" Height="26" Margin="4,0" VerticalContentAlignment="Center"
                                 Text="1" ToolTip="积攒多少个采样点批量写盘一次"/>
                        <TextBlock Text="点写盘一次" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbSaveByTime" Content="按时间保存：每" GroupName="SaveMode"
                                     VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtSaveSeconds" Width="60" Height="26" Margin="4,0" VerticalContentAlignment="Center"
                                 Text="5" IsEnabled="False" ToolTip="最长间隔多久写盘一次"/>
                        <ComboBox x:Name="CmbSaveTimeUnit" Width="70" Height="26" SelectedIndex="0" IsEnabled="False">
                            <ComboBoxItem Content="秒" Tag="1"/>
                            <ComboBoxItem Content="分钟" Tag="60"/>
                            <ComboBoxItem Content="小时" Tag="3600"/>
                        </ComboBox>
                        <TextBlock Text="写盘一次" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="12,4,0,8"
                           Text="采样先进内存缓冲，后台线程按所选条件批量写入 CSV，不占用采集线程；任务停止/程序退出时自动写完剩余数据。"/>

                <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                           Text="任务启动后将按设定间隔持续采样目标属性的当前值，并在任务列表中实时显示。"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区：固定在窗口底部，不随内容滚动 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnOK" Content="确定添加" Padding="28,8" Click="BtnOK_Click"
                    IsDefault="True" MinWidth="150" FontSize="13" FontWeight="Bold"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="28,8" Margin="20,0,0,0" Click="BtnCancel_Click"
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
