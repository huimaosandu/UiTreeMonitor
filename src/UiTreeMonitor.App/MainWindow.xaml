<Window x:Class="UiTreeMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UiTreeMonitor.App"
        Title="UI 结构树监控平台" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具条 ===== -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <TextBlock Text="目标窗口：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="WindowCombo" Width="360" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="BtnRefreshWindows" Content="刷新窗口" Margin="8,0,0,0" Padding="10,4" Click="BtnRefreshWindows_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnCaptureTree" Content="抓取结构树" Margin="8,0,0,0" Padding="10,4" Click="BtnCaptureTree_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnMouseCapture" Content="随鼠标捕获" Margin="8,0,0,0" Padding="10,4" Click="BtnMouseCapture_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtCaptureStatus" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"/>
            </DockPanel>
        </Border>

        <!-- ===== 主体（左右可拖拽） ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" x:Name="ColLeft"/>
                <ColumnDefinition Width="Auto"/>   <!-- GridSplitter -->
                <ColumnDefinition Width="3*" MinWidth="400" x:Name="ColRight"/>
            </Grid.ColumnDefinitions>

            <!-- 左右分界线拖拽 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#CCCCCC"
                          ResizeBehavior="PreviousAndCurrent"/>

            <!-- ===== 左侧：结构树 + Details（上下可拖拽） ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" x:Name="RowTree"/>
                    <RowDefinition Height="Auto"/>    <!-- GridSplitter -->
                    <RowDefinition Height="280" MinHeight="120" x:Name="RowDetails"/>
                </Grid.RowDefinitions>

                <!-- 上下分界线拖拽 -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" Background="#CCCCCC"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- 上半：结构树 -->
                <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                    <DockPanel>
                        <TextBlock Text="结构树" FontWeight="Bold" DockPanel.Dock="Top" Margin="2,0,0,6"/>
                        <TreeView x:Name="TreeView" DockPanel.Dock="Top" SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Display}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#FFD666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 下半：Details 面板（Properties + Patterns） -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="4">
                    <DockPanel>
                        <TextBlock x:Name="TxtDetailsTitle" Text="选中节点查看详情" FontWeight="Bold"
                                   DockPanel.Dock="Top" Margin="2,2,0,4" Foreground="#333333"/>

                        <StackPanel DockPanel.Dock="Top">
                            <!-- Properties Expander -->
                            <Expander Header="Properties" IsExpanded="True" Margin="0,2">
                                <DataGrid x:Name="PropertiesGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" RowHeight="24"
                                          FontSize="12" Background="White"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          MouseRightButtonUp="PropertiesGrid_MouseRightButtonUp">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性名" Binding="{Binding Name}" Width="120"/>
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Expander>

                            <!-- Patterns Expander -->
                            <Expander Header="Patterns" IsExpanded="True" Margin="0,2">
                                <TreeView x:Name="PatternsTree" FontSize="12" Background="White"
                                          BorderThickness="1" BorderBrush="#DDDDDD"
                                          MaxHeight="160" MouseRightButtonUp="PatternsTree_MouseRightButtonUp">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:PatternItem}" ItemsSource="{Binding SubProperties}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Value}" Foreground="#0066CC"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Expander>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== 右侧：任务管理 + 采样历史 ===== -->
            <Grid Grid.Column="2">
                <TabControl Margin="8">
                    <TabItem Header="任务管理">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 提示 + 操作按钮 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="操作：在左侧 Details 面板右键属性/Pattern →「添加为监控对象」" 
                                           VerticalAlignment="Center" Foreground="#666666" Margin="0,0,16,0"/>
                                <Button x:Name="BtnStopTask" Content="停止选中" Padding="10,4" Margin="0,0,6,0" Click="BtnStopTask_Click"
                                        ToolTip="暂停选中的监控任务"/>
                                <Button x:Name="BtnResumeTask" Content="继续选中" Padding="10,4" Margin="0,0,6,0" Click="BtnResumeTask_Click"
                                        ToolTip="恢复选中的监控任务"/>
                                <Button x:Name="BtnRemoveTask" Content="移除选中" Padding="10,4" Margin="0,0,6,0" Click="BtnRemoveTask_Click"
                                        ToolTip="移除选中的监控任务"/>
                                <Button x:Name="BtnExport" Content="导出报告" Padding="10,4" Click="BtnExport_Click"
                                        ToolTip="导出采样数据报告"/>
                            </StackPanel>

                            <!-- 监控任务列表（显示实时值） -->
                            <GroupBox Header="监控任务" Grid.Row="2" Padding="8">
                                <ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="任务名" Width="100" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="监控目标" Width="130" DisplayMemberBinding="{Binding MonitorProperty}"/>
                                            <GridViewColumn Header="当前值" Width="140" DisplayMemberBinding="{Binding CurrentValue}"/>
                                            <GridViewColumn Header="采样数" Width="55" DisplayMemberBinding="{Binding SampleCount}"/>
                                            <GridViewColumn Header="状态" Width="60" DisplayMemberBinding="{Binding State}"/>
                                            <GridViewColumn Header="间隔" Width="55" DisplayMemberBinding="{Binding IntervalMs}"/>
                                            <GridViewColumn Header="上次采样" Width="120" DisplayMemberBinding="{Binding LastSampleTime}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="采样历史">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}" Width="170"/>
                                    <DataGridTextColumn Header="节点ID" Binding="{Binding NodeId}" Width="60"/>
                                    <DataGridTextColumn Header="节点路径" Binding="{Binding NodePath}" Width="*"/>
                                    <DataGridTextColumn Header="属性" Binding="{Binding Property}" Width="110"/>
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtHistoryStatus" Grid.Row="1" Margin="2,4" Foreground="#666666"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
