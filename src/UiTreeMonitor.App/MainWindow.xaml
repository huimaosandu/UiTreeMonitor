<Window x:Class="UiTreeMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UiTreeMonitor.App"
        xmlns:ctrl="clr-namespace:UiTreeMonitor.App.Controls"
        Title="UI 结构树监控平台" Height="760" Width="1280"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具条 ===== -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <!-- 数据目录/设置 靠最右（先 Dock Right 占据右端） -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnOpenDataDir" Content="数据目录" Margin="8,0,0,0" Padding="10,4"
                            Click="BtnOpenDataDir_Click" ToolTip="打开数据保存文件夹（D:\uitreemonitor\当日日期）"/>
                    <Button x:Name="BtnSettings" Content="设置" Margin="8,0,0,0" Padding="10,4"
                            Click="BtnSettings_Click" ToolTip="设置截取字符等全局选项"/>
                </StackPanel>
                <TextBlock Text="目标窗口：" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                <ComboBox x:Name="WindowCombo" Width="360" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="BtnRefreshWindows" Content="刷新窗口" Margin="8,0,0,0" Padding="10,4" Click="BtnRefreshWindows_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnCaptureTree" Content="抓取结构树" Margin="8,0,0,0" Padding="10,4" Click="BtnCaptureTree_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnMouseCapture" Content="随鼠标捕获" Margin="8,0,0,0" Padding="10,4" Click="BtnMouseCapture_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtCaptureStatus" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"/>
            </DockPanel>
        </Border>

        <!-- ===== 主体（左右可拖拽） ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" x:Name="ColLeft"/>
                <!-- ★ splitter 列固定宽（Auto 列拖动时反复重算会漂移：相邻星号列被持续缩小、与 splitter 间出现空隙） -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="3*" MinWidth="400" x:Name="ColRight"/>
            </Grid.ColumnDefinitions>

            <!-- 左右分界线拖拽（PreviousAndNext：调整左右两栏；严禁 PreviousAndCurrent——
                 它会调整"左栏+splitter 自身列"，splitter 列被拖宽=中间出现空带、左栏持续缩小） -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#CCCCCC"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

            <!-- ===== 左侧：结构树 + Details（上下可拖拽，默认高度比 4:6） ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="150" x:Name="RowTree"/>
                    <!-- ★ splitter 行固定高（同 splitter 列 Auto 漂移 bug） -->
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="6*" MinHeight="200" x:Name="RowDetails"/>
                </Grid.RowDefinitions>

                <!-- 上下分界线拖拽 -->
                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Background="#CCCCCC"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                <!-- 上半：结构树 -->
                <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                    <DockPanel>
                        <!-- 标题行 + 关键词检索（检索命中的节点浅绿、捕获高亮黄色） -->
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <TextBlock Text="结构树" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="BtnSearchClear" Content="清空" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    Padding="8,2" Click="BtnSearchClear_Click" ToolTip="清除检索关键词与命中标记"/>
                            <Button x:Name="BtnSearchNext" Content="下一个" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    Padding="8,2" Click="BtnSearchNext_Click" ToolTip="跳到下一处命中（Enter 同效）"/>
                            <Button x:Name="BtnSearchPrev" Content="上一个" DockPanel.Dock="Right" Margin="6,0,0,0"
                                    Padding="8,2" Click="BtnSearchPrev_Click" ToolTip="跳到上一处命中（Shift+Enter 同效）"/>
                            <TextBlock x:Name="TxtSearchCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Margin="8,0,0,0" MinWidth="110" Foreground="#666666" Text=""/>
                            <TextBox x:Name="TxtTreeSearch" Margin="10,0,0,0" Padding="4,2" Height="24"
                                     VerticalContentAlignment="Center"
                                     ToolTip="按 Name / AutomationId / ClassName / ControlType 检索；空格分隔多个关键词（同时满足）"
                                     TextChanged="TxtTreeSearch_TextChanged" KeyDown="TxtTreeSearch_KeyDown"/>
                        </DockPanel>
                        <!-- ★ 关虚拟化：TreeViewItem 容器必须真实生成，鼠标捕获的“展开到目标节点”才可靠
                             （虚拟化下深层容器延迟生成，ExpandPath 会在中途 break，表现为“抓到元素但树不动”） -->
                        <TreeView x:Name="TreeView" DockPanel.Dock="Top" SelectedItemChanged="TreeView_SelectedItemChanged"
                                  VirtualizingPanel.IsVirtualizing="False">
                            <TreeView.Resources>
                                <!-- 鼠标捕获高亮：整行底色 + 加粗 + 左边框，比只染文字底色更醒目 -->
                                <Style TargetType="TreeViewItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#FFD666"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#D97706"/>
                                            <Setter Property="BorderThickness" Value="2,0,0,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Display}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#FFD666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 下半：Details 面板（Properties + Patterns） -->
                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="4">
                    <DockPanel>
                        <TextBlock x:Name="TxtDetailsTitle" Text="选中节点查看详情" FontWeight="Bold"
                                   DockPanel.Dock="Top" Margin="2,2,0,4" Foreground="#333333"/>

                        <StackPanel DockPanel.Dock="Top">
                            <!-- Properties Expander -->
                            <Expander Header="Properties" IsExpanded="True" Margin="0,2">
                                <DataGrid x:Name="PropertiesGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" RowHeight="24"
                                          FontSize="12" Background="White"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          MouseRightButtonUp="PropertiesGrid_MouseRightButtonUp">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性名" Binding="{Binding Name}" Width="120"/>
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Expander>

                            <!-- Patterns Expander -->
                            <Expander Header="Patterns" IsExpanded="True" Margin="0,2">
                                <TreeView x:Name="PatternsTree" FontSize="12" Background="White"
                                          BorderThickness="1" BorderBrush="#DDDDDD"
                                          MaxHeight="260" MouseRightButtonUp="PatternsTree_MouseRightButtonUp">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.Resources>
                                        <!-- Pattern 行：名字 + 首个属性值 + Actions 按钮 -->
                                        <HierarchicalDataTemplate DataType="{x:Type local:PatternItem}" ItemsSource="{Binding SubProperties}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Value}" Foreground="#0066CC"/>
                                                <!-- ★ FallbackValue：子属性行若走到这个模板，HasActions 绑定失败时
                                                     WPF 会用按钮默认值 Visible 把按钮画出来（原版的 bug），必须显式兜底 -->
                                                <Button Content="Actions..." Visibility="{Binding HasActions, Converter={x:Static local:BoolToVisibilityConverter.Default}, FallbackValue=Collapsed}"
                                                        Click="PatternAction_Click" Margin="8,0,0,0"
                                                        Padding="4,2" FontSize="11" FontWeight="Normal"
                                                        ToolTip="执行此 Pattern 的 UIA 操作方法"
                                                        Tag="{Binding PatternIndex}"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                        <!-- 属性行（Pattern 的子属性）：只显示 "属性名 = 值"，没有 Actions -->
                                        <DataTemplate DataType="{x:Type local:PropertyItem}">
                                            <TextBlock Text="{Binding Value}" Foreground="#0066CC" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullValue}"/>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Expander>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== 右侧：任务管理 + 录制回放 ===== -->
            <Grid Grid.Column="2">
                <TabControl x:Name="MainTabs" Margin="8">
                    <TabItem Header="任务管理">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="120"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*" MinHeight="120"/>
                            </Grid.RowDefinitions>

                            <!-- 提示 + 操作按钮 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="右键任务行可单独操作；按钮作用于全部任务："
                                           VerticalAlignment="Center" Foreground="#666666" Margin="0,0,16,0"/>
                                <Button x:Name="BtnStartAllTasks" Content="启动所有任务" Padding="10,4" Margin="0,0,6,0" Click="BtnStartAllTasks_Click"
                                        ToolTip="启动全部监控任务（未启动→启动；已停止→恢复；运行中跳过）"/>
                                <Button x:Name="BtnStopAllTasks" Content="停止所有任务" Padding="10,4" Margin="0,0,6,0" Click="BtnStopAllTasks_Click"
                                        ToolTip="停止全部监控任务"/>
                                <Button x:Name="BtnRemoveAllTasks" Content="移除所有任务" Padding="10,4" Click="BtnRemoveAllTasks_Click"
                                        ToolTip="移除全部监控任务（剩余采样数据自动落盘）"/>
                            </StackPanel>

                            <!-- 录制任务列表（脚本回放任务；右键启动/停止/查看状态）
                                 ★ 与监控任务结构完全一致：无 Margin、Padding=8、ListView 直接填满 GroupBox
                                 （原内层 Grid 双 Auto 行使 ListView 不拉伸、表格只占内容高度，视觉比监控任务小） -->
                            <GroupBox Grid.Row="1" Padding="8">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="录制任务（脚本回放）" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="　右键空白处：添加任务；右键任务行：启动 / 停止 / 状态 / 移除"
                                                   Foreground="#666666" FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <!-- ★ 菜单挂 GroupBox（ContextMenuService 沿可视树向上查找）：
                                     右键列表行/列表空白处/标题区均弹同一菜单——空白处右键即可"添加录制任务" -->
                                <GroupBox.ContextMenu>
                                    <ContextMenu x:Name="MenuRecTask" Opened="RecTaskContextMenu_Opened">
                                        <MenuItem Header="添加录制任务…" Click="BtnAddRecTask_Click"
                                                  ToolTip="从 RecordingTasks 目录（或任意位置）选择录制任务 JSON 加入列表"/>
                                        <Separator/>
                                        <MenuItem Header="启动任务" x:Name="MenuRecTaskStart" Click="MenuRecTaskStart_Click"/>
                                        <MenuItem Header="停止任务" x:Name="MenuRecTaskStop" Click="MenuRecTaskStop_Click"/>
                                        <MenuItem Header="查看任务状态" Click="MenuRecTaskStatus_Click"/>
                                        <Separator/>
                                        <MenuItem Header="移除（仅列表）" Click="MenuRecTaskRemove_Click"/>
                                    </ContextMenu>
                                </GroupBox.ContextMenu>
                                <!-- Background=White 保证空白区域命中右键；行样式与监控任务列表一致（内容拉伸对齐） -->
                                <ListView x:Name="RecTaskList" SelectionMode="Single" Background="White"
                                          MouseRightButtonUp="RecTaskList_MouseRightButtonUp">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="任务名" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding StateText}"/>
                                            <GridViewColumn Header="当前步骤" Width="220" DisplayMemberBinding="{Binding CurrentStep}"/>
                                            <GridViewColumn Header="进度" Width="70" DisplayMemberBinding="{Binding Progress}"/>
                                            <GridViewColumn Header="步骤数" Width="55" DisplayMemberBinding="{Binding StepCount}"/>
                                            <GridViewColumn Header="开始时间" Width="80" DisplayMemberBinding="{Binding StartedText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>

                            <!-- 录制任务与监控任务默认等高：拖动中间分割线调整两者比例（行固定高防 splitter 漂移） -->
                            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" Background="#CCCCCC"
                                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" ResizeDirection="Rows"
                                          ToolTip="拖动调整上下两个列表的高度比例"/>

                            <!-- 监控任务列表（显示实时值；右键行操作；菜单挂 GroupBox=空白处右键也可添加任务） -->
                            <GroupBox Header="监控任务" Grid.Row="3" Padding="8">
                                <GroupBox.ContextMenu>
                                    <ContextMenu Opened="TaskContextMenu_Opened">
                                        <!-- 空白处右键即可添加（等同顶部"随鼠标捕获"按钮）：入口贴近列表 -->
                                        <MenuItem Header="添加监控任务（随鼠标捕获）…" x:Name="MenuAddTaskByCapture"
                                                  Click="MenuAddTaskByCapture_Click"
                                                  ToolTip="悬停选中元素后点蓝框右上角烧杯，将其添加为监测目标（与顶部按钮一致）"/>
                                        <Separator/>
                                        <MenuItem Header="启动采集" x:Name="MenuStartTask" Click="MenuStartTask_Click"/>
                                        <MenuItem Header="停止采集" x:Name="MenuStopTask" Click="MenuStopTask_Click"/>
                                        <MenuItem Header="继续采集" x:Name="MenuResumeTask" Click="MenuResumeTask_Click"/>
                                        <MenuItem Header="移除任务" Click="MenuRemoveTask_Click"/>
                                        <MenuItem Header="查看监控配置" Click="MenuViewTask_Click"/>
                                        <Separator/>
                                        <MenuItem Header="生成数据图" Click="MenuExportTask_Click"/>
                                        <MenuItem Header="同步启动选中（严格同刻采样）" x:Name="MenuSyncStart" Click="MenuSyncStart_Click"/>
                                        <MenuItem Header="合并导出数据报告（多任务同一文件夹）" x:Name="MenuMergeReport" Click="MenuMergeReport_Click"/>
                                    </ContextMenu>
                                </GroupBox.ContextMenu>
                                <ListView x:Name="TaskList" SelectionMode="Extended" Background="White"
                                          MouseRightButtonUp="TaskList_MouseRightButtonUp">
                                    <ListView.ItemContainerStyle>
                                        <!-- 同步组任务整行淡色（SyncGroupRowBrush 为 null 时透明=普通任务）；内容拉伸对齐 -->
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background"
                                                    Value="{Binding SyncGroupRowBrush, TargetNullValue=Transparent}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="任务名" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="组" Width="76">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <!-- 同步组标识：组色点 + "同步器N"（独立任务为空白） -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                                                     Fill="{Binding SyncGroupDotBrush, TargetNullValue=Transparent}"/>
                                                            <TextBlock Text="{Binding SyncGroupTag}" VerticalAlignment="Center" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="监控目标" Width="130" DisplayMemberBinding="{Binding MonitorProperty}"/>
                                            <GridViewColumn Header="当前值" Width="130" DisplayMemberBinding="{Binding CurrentValue}"/>
                                            <GridViewColumn Header="采样数" Width="55" DisplayMemberBinding="{Binding SampleCount}"/>
                                            <GridViewColumn Header="状态" Width="60" DisplayMemberBinding="{Binding State}"/>
                                            <GridViewColumn Header="间隔" Width="55" DisplayMemberBinding="{Binding IntervalMs}"/>
                                            <GridViewColumn Header="上次采样" Width="110" DisplayMemberBinding="{Binding LastSampleTime}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="录制回放" x:Name="TabRecording">
                        <ctrl:RecordingPanel x:Name="RecordingPanel"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
