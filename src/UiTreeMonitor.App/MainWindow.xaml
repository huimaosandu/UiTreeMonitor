<Window x:Class="UiTreeMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UiTreeMonitor.App"
        Title="UI 结构树监控平台" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具条 ===== -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <TextBlock Text="目标窗口：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="WindowCombo" Width="360" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Button x:Name="BtnRefreshWindows" Content="刷新窗口" Margin="8,0,0,0" Padding="10,4" Click="BtnRefreshWindows_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnCaptureTree" Content="抓取结构树" Margin="8,0,0,0" Padding="10,4" Click="BtnCaptureTree_Click" DockPanel.Dock="Left"/>
                <Button x:Name="BtnMouseCapture" Content="随鼠标捕获" Margin="8,0,0,0" Padding="10,4" Click="BtnMouseCapture_Click" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtCaptureStatus" Text="" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666666"/>
            </DockPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：结构树 + Details -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <!-- 上半：结构树 -->
                <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="6">
                    <DockPanel>
                        <TextBlock Text="结构树" FontWeight="Bold" DockPanel.Dock="Top" Margin="2,0,0,6"/>
                        <TreeView x:Name="TreeView" DockPanel.Dock="Top" SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Display}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#FFD666"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 下半：Details 面板（Properties + Patterns） -->
                <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="4">
                    <DockPanel>
                        <TextBlock x:Name="TxtDetailsTitle" Text="选中节点查看详情" FontWeight="Bold"
                                   DockPanel.Dock="Top" Margin="2,2,0,4" Foreground="#333333"/>

                        <StackPanel DockPanel.Dock="Top">
                            <!-- Properties Expander -->
                            <Expander Header="Properties" IsExpanded="True" Margin="0,2">
                                <DataGrid x:Name="PropertiesGrid" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" RowHeight="24"
                                          FontSize="12" Background="White"
                                          SelectionMode="Single" SelectionUnit="FullRow"
                                          MouseRightButtonUp="PropertiesGrid_MouseRightButtonUp">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="属性名" Binding="{Binding Name}" Width="120"/>
                                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Expander>

                            <!-- Patterns Expander -->
                            <Expander Header="Patterns" IsExpanded="True" Margin="0,2">
                                <TreeView x:Name="PatternsTree" FontSize="12" Background="White"
                                          BorderThickness="1" BorderBrush="#DDDDDD"
                                          MouseRightButtonUp="PatternsTree_MouseRightButtonUp">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加为监测目标" Click="MenuItem_AddAsTarget_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type local:PatternItem}" ItemsSource="{Binding SubProperties}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Value}" Foreground="#0066CC"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Expander>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 右侧：任务 + 历史 -->
            <Grid Grid.Column="1">
                <TabControl Margin="8">
                    <TabItem Header="任务管理">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 任务表单 -->
                            <GroupBox Header="新建监控任务（七要素）" Grid.Row="0" Padding="8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="任务名：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTaskName" Grid.Column="1" Margin="4,2" Text="任务1"/>
                                    <TextBlock Text="目标：" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <ComboBox x:Name="CmbTargetKind" Grid.Column="3" Margin="4,2" SelectionChanged="CmbTargetKind_SelectionChanged">
                                        <ComboBoxItem Content="进程名" Tag="Process"/>
                                        <ComboBoxItem Content="窗口句柄" Tag="WindowHandle"/>
                                        <ComboBoxItem Content="窗口标题" Tag="WindowTitle"/>
                                    </ComboBox>

                                    <TextBlock Text="目标值：" Grid.Row="1" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtTargetValue" Grid.Row="1" Grid.Column="1" Margin="4,2" Text="notepad"/>
                                    <TextBlock Text="属性：" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtProperties" Grid.Row="1" Grid.Column="3" Margin="4,2" Text="Name,Value"/>

                                    <TextBlock Text="正则过滤：" Grid.Row="2" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtFilter" Grid.Row="2" Grid.Column="1" Margin="4,2" Text="" ToolTip="如 Name~^温度(?&lt;value&gt;\d+) 或 Name~温度"/>
                                    <TextBlock Text="采集间隔(ms)：" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtInterval" Grid.Row="2" Grid.Column="3" Margin="4,2" Text="1000"/>

                                    <TextBlock Text="触发器：" Grid.Row="3" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbTrigger" Grid.Row="3" Grid.Column="1" Margin="4,2">
                                        <ComboBoxItem Content="立刻" Tag="Immediate"/>
                                        <ComboBoxItem Content="定时" Tag="Schedule"/>
                                        <ComboBoxItem Content="值变化" Tag="ValueChange"/>
                                        <ComboBoxItem Content="阈值" Tag="Threshold"/>
                                    </ComboBox>
                                    <TextBlock Text="时间器(秒)：" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TxtTimeBox" Grid.Row="3" Grid.Column="3" Margin="4,2" Text="0" ToolTip="0=不限时；N=运行N秒后结束"/>
                                </Grid>
                            </GroupBox>

                            <!-- 任务操作 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="BtnAddTask" Content="添加并启动任务" Padding="14,6" Margin="0,0,8,0" Click="BtnAddTask_Click"/>
                                <Button x:Name="BtnStopTask" Content="停止选中任务" Padding="14,6" Margin="0,0,8,0" Click="BtnStopTask_Click"/>
                                <Button x:Name="BtnRemoveTask" Content="移除选中任务" Padding="14,6" Margin="0,0,8,0" Click="BtnRemoveTask_Click"/>
                                <Button x:Name="BtnExport" Content="导出选中任务报告" Padding="14,6" Click="BtnExport_Click"/>
                            </StackPanel>

                            <!-- 任务列表 -->
                            <GroupBox Header="运行中的任务" Grid.Row="2" Padding="8">
                                <ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="任务名" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding State}"/>
                                            <GridViewColumn Header="采样数" Width="70" DisplayMemberBinding="{Binding SampleCount}"/>
                                            <GridViewColumn Header="目标" Width="160" DisplayMemberBinding="{Binding TargetText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </GroupBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="采样历史">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Grid.Row="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}" Width="170"/>
                                    <DataGridTextColumn Header="节点ID" Binding="{Binding NodeId}" Width="70"/>
                                    <DataGridTextColumn Header="节点路径" Binding="{Binding NodePath}" Width="*"/>
                                    <DataGridTextColumn Header="属性" Binding="{Binding Property}" Width="120"/>
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtHistoryStatus" Grid.Row="1" Margin="2,4" Foreground="#666666"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
