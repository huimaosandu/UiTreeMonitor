<Window x:Class="UiTreeMonitor.App.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="230" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei" FontSize="13">
    <StackPanel Margin="20,16">

        <!-- 截取字符 -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="截取字符：" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtExtractMarker" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                     ToolTip="值提取的默认标记（起止同串）。例：@@ 截取 @@614.466@@ → 614.466"/>
        </Grid>
        <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="监控值中成对出现该字符时，软件自动截取两者之间的内容作为提取值。新增任务的提取规则默认使用此标记；建议选不易与监控值冲突的字符（默认 @@）。"/>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnOK" Content="保存" Padding="28,8" Click="BtnOK_Click"
                    IsDefault="True" MinWidth="100" FontSize="13" FontWeight="Bold"/>
            <Button x:Name="BtnCancel" Content="取消" Padding="28,8" Margin="16,0,0,0" Click="BtnCancel_Click"
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </StackPanel>
</Window>
