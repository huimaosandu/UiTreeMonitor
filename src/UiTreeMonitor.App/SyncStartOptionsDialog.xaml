<Window x:Class="UiTreeMonitor.App.SyncStartOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步采集组配置（选中的任务将统一使用以下参数）"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="同步采集参数（组内所有任务强制一致，保证时间轴严格同刻）"
                       FontWeight="Bold" Margin="0,0,0,12"/>

            <!-- 采集间隔：数字 + 单位 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="采集间隔：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtIntervalValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                         Text="500" ToolTip="最小 100ms"/>
                <ComboBox x:Name="CmbIntervalUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                          SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="ms" Tag="1"/>
                    <ComboBoxItem Content="s" Tag="1000"/>
                    <ComboBoxItem Content="min" Tag="60000"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="（最小 100ms，全组统一节拍）" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="#999999" FontSize="12"/>
            </Grid>

            <!-- 监控时长：数字 + 单位 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="监控时长：" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtDurationValue" Grid.Column="1" Height="28" VerticalContentAlignment="Center"
                         Text="0" ToolTip="0 = 无限监控"/>
                <ComboBox x:Name="CmbDurationUnit" Grid.Column="2" Margin="6,0,0,0" Width="70" Height="28"
                          SelectedIndex="1" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="s" Tag="1"/>
                    <ComboBoxItem Content="min" Tag="60"/>
                    <ComboBoxItem Content="h" Tag="3600"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="（0 = 无限；到时全组同时完成）" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="#999999" FontSize="12"/>
            </Grid>

            <Separator Margin="0,0,0,12"/>

            <!-- 数据保存策略：候选 按点保存 / 按时间保存（与新建任务弹窗同款语义） -->
            <TextBlock Text="数据保存方式：" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Margin="12,0,0,6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <RadioButton x:Name="RbSaveByPoints" Content="按点保存：每" GroupName="SaveMode"
                                 IsChecked="True" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSavePoints" Width="60" Height="26" Margin="4,0" VerticalContentAlignment="Center"
                             Text="10" ToolTip="积攒多少个采样点批量写盘一次"/>
                    <TextBlock Text="点写盘一次" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbSaveByTime" Content="按时间保存：每" GroupName="SaveMode"
                                 VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSaveSeconds" Width="60" Height="26" Margin="4,0" VerticalContentAlignment="Center"
                             Text="5" IsEnabled="False" ToolTip="最长间隔多久写盘一次"/>
                    <ComboBox x:Name="CmbSaveTimeUnit" Width="70" Height="26" SelectedIndex="0" IsEnabled="False">
                        <ComboBoxItem Content="秒" Tag="1"/>
                        <ComboBoxItem Content="分钟" Tag="60"/>
                    </ComboBox>
                    <TextBlock Text="写盘一次" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="12,4,0,0"
                       Text="以上参数将覆盖选中任务的各自配置并全组统一；每任务仍落盘独立 CSV，导出时可合并到同一张图/同一份报告。"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnOK" Content="开始同步采集" Padding="24,8" Click="BtnOK_Click"
                    IsDefault="True" MinWidth="140" FontSize="13" FontWeight="Bold"/>
            <Button Content="取消" Padding="24,8" Margin="16,0,0,0" Click="BtnCancel_Click"
                    IsCancel="True" MinWidth="80" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
